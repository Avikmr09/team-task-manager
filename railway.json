{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "backend": {
      "source": {
        "directory": "backend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "numReplicas": 1,
        "sleepOnIdle": false
      }
    },
    "frontend": {
      "source": {
        "directory": "frontend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "numReplicas": 1,
        "sleepOnIdle": false
      }
    }
  }
}
